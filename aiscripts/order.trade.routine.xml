<?xml version="1.0" encoding="utf-8" ?>

<diff>
    <add sel="/aiscript[@name='order.trade.routine']/init/do_if[@value='this.isplayerowned']/set_value[@name='$maxrange']" pos="after">
        <!-- Add code to limit operational range -->
        <remove_value name="$limitToSector" comment="Remove flag from previous run" />
        <do_if value="@this.assignedcontrolled.commander.isclass.station and this.assignedcontrolled.commander.isplayerowned">
            <set_value name="$idcode" exact="this.assignedcontrolled.commander.idcode" />
            <do_if value="global.$v1024_logGuideTradeRangeTable.$idcode?">
                <!-- Value exists; right now assume is 0 range (i.e. cluster) -->
                <set_value name="$maxrange" exact="0" />
                <do_if value="global.$v1024_logGuideTradeRangeTable.$idcode == 'sector'">
                    <!-- We want the sector -->
                    <set_value name="$limitToSector" exact="true" />
                </do_if>
            </do_if>
        </do_if>
    </add>

    <add sel="/aiscript[@name='order.trade.routine']/attention/actions/run_script[@result='$buyspaces']">
        <!-- Restrict to sector if we specified it -->
        <!-- This is actually a lib.find.sectors.inrange -->
        <param name="usesectordistance" value="if $limitToSector? then true else false" />
    </add>
    <add sel="/aiscript[@name='order.trade.routine']/attention/actions/do_if/run_script[@result='$sellspaces']">
        <!-- Restrict to sector if we specified it -->
        <!-- This is actually a lib.find.sectors.inrange -->
        <param name="usesectordistance" value="if $limitToSector? then true else false" />
    </add>
</diff>
